<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Jellyfin 10.11.x: net9.0 + 10.11.x | Jellyfin 12.x: net10.0 + 12.x
         Beispiel: dotnet build -c Release -p:JellyfinTfm=net10.0 -p:JellyfinVersion=12.4.0 -->
    <JellyfinTfm Condition="'$(JellyfinTfm)' == ''">net9.0</JellyfinTfm>
    <TargetFramework>$(JellyfinTfm)</TargetFramework>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">10.11.0</JellyfinVersion>
    <RootNamespace>Jellyfin.Plugin.HAnimeDownloader</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.HAnimeDownloader</AssemblyName>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Server stellt diese Assemblies selbst bereit -> nicht mit ausliefern -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <!-- Die eigentliche Web-UI liegt zentral in /web und wird hier eingebettet -->
    <EmbeddedResource Include="..\..\web\client.js" LogicalName="Jellyfin.Plugin.HAnimeDownloader.Web.client.js" />
  </ItemGroup>

</Project>
